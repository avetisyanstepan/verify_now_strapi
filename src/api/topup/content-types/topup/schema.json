    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "topups"
    },
    "provider": {
      "type": "string"
    },
    "providerRef": {
      "type": "string"
    },
    "statuss": {
      "type": "enumeration",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded",
        "partially_paid",
        "expired"
      ]
    },
    "processed": {
      "type": "boolean",
      "default": false
    },
    "payAddress": {
      "type": "string"
    },
    "payNetwork": {
      "type": "string"
    },
    "providerPayload": {
      "type": "json"
    }
  }
