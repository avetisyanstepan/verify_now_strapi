{
  "kind": "collectionType",
  "collectionName": "topups",
  "info": {
    "singularName": "topup",
    "pluralName": "topups",
    "displayName": "topup"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "amountUsd": {
      "type": "decimal"
    },
    "amoutnAmd": {
